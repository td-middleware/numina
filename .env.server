# =============================================================================
# Numina Cloud Server — 环境变量模板
#
# 使用方法：
#   cp .env.server .env
#   vim .env          # 填写真实值
#   docker compose up -d
#
# ⚠️  .env 文件包含密钥，已加入 .gitignore，请勿提交到 Git
# =============================================================================

# ── 飞书机器人凭证 ────────────────────────────────────────────────────────────
# 在飞书开放平台创建应用后获取：https://open.feishu.cn/app
# 机器人身份（bot）无需浏览器授权，只需 App ID + App Secret
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LARK_BRAND=feishu   # feishu（默认）或 lark（国际版）

# ── AI 模型 API Key ───────────────────────────────────────────────────────────
# 至少填写一个
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx

# ── Numina Server 配置 ────────────────────────────────────────────────────────
NUMINA_PORT=14521
# 建议生产环境设置 API Token，防止未授权访问
NUMINA_API_TOKEN=your-secret-token-here

# ── 日志 ─────────────────────────────────────────────────────────────────────
# RUST_LOG=numina=info
# TZ=Asia/Shanghai
